# MetMind — example environment file
# Copy this to ".env" (same folder) and fill in your values.

# ── Groq LLM (required for meeting analysis / summaries) ──
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model used for analysis
GROQ_MODEL=llama-3.3-70b-versatile

# ── Speech-to-Text engine ──
# "groq" — Cloud-based, fast, real-time (recommended)
# "whisper" — Local faster-whisper, offline, slower on CPU
# "nemo" — NVIDIA Parakeet, GPU-accelerated (requires CUDA)
STT_ENGINE=groq

# ── Whisper (local engine only) ──
# Options: tiny, base, small, medium, large-v3, large-v3-turbo
# large-v3-turbo: best speed/accuracy balance (recommended)
WHISPER_MODEL=large-v3-turbo

# Live transcription tuning (seconds)
# buffer: how much audio to accumulate before transcribing (default 4.0)
# overlap: overlap between batches for context continuity (default 1.0)
# Higher buffer = better accuracy but more latency
WHISPER_BUFFER_S=4.0
WHISPER_OVERLAP_S=1.0

# ── Server ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# ── Frontend ──
FRONTEND_URL=http://localhost:5173
